# Fastfile for Cutting Log.
#
# Lives at the repository root and drives the native Xcode project.

require "base64"
require "fileutils"
require "tmpdir"

default_platform(:ios)

APP_IDENTIFIER = "com.infinityball.cuttinglog".freeze
# Must match DEVELOPMENT_TEAM in ios/Runner.xcodeproj/project.pbxproj.
DEVELOPMENT_TEAM = "2ES87W257J".freeze

platform :ios do
  desc "Build a signed release IPA and upload it to TestFlight."
  lane :beta do
    build = build_release_ipa

    upload_to_testflight(
      api_key: build[:api_key],
      app_identifier: APP_IDENTIFIER,
      ipa: build[:ipa],
      skip_waiting_for_build_processing: true
    )

    UI.success("Uploaded #{build[:build_name]} (#{build[:build_number]}) to TestFlight.")
  end

  desc "Build a signed release IPA, upload it, and submit it for App Store review."
  lane :release do
    build = build_release_ipa

    upload_to_app_store(
      api_key: build[:api_key],
      app_identifier: APP_IDENTIFIER,
      ipa: build[:ipa],
      app_version: build[:build_name],
      submit_for_review: true,
      automatic_release: true,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )

    UI.success("Submitted #{build[:build_name]} (#{build[:build_number]}) for App Store review.")
  end

  # Shared build step for both lanes.
  #
  # App Store Connect remains the source of truth for monotonically increasing
  # build numbers.
  private_lane :build_release_ipa do
    api_key = app_store_connect_api_key(
      key_id: required_env("ASC_KEY_ID"),
      issuer_id: required_env("ASC_ISSUER_ID"),
      key_content: app_store_api_key_base64,
      is_key_content_base64: true,
      in_house: false
    )

    setup_ci

    build_number = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: APP_IDENTIFIER,
      initial_build_number: 0
    ).to_i + 1

    build_name = marketing_version

    UI.message("Building #{APP_IDENTIFIER} #{build_name} (#{build_number}) from #{project_root}")

    with_xcode_signing_credentials do
      archive = File.join(signing_workdir, "Runner.xcarchive")
      sh("cd \"#{project_root}\" && xcodebuild " \
         "-project ios/Runner.xcodeproj -scheme Runner -configuration Release " \
         "-destination generic/platform=iOS " \
         "MARKETING_VERSION=#{build_name} CURRENT_PROJECT_VERSION=#{build_number} " \
         "-archivePath \"#{archive}\" " \
         "#{xcodebuild_auth_flags} archive")

      FileUtils.rm_rf(ipa_output_dir)
      FileUtils.mkdir_p(ipa_output_dir)
      sh("cd \"#{project_root}\" && xcodebuild -exportArchive " \
         "-archivePath \"#{archive}\" " \
         "-exportPath \"#{ipa_output_dir}\" " \
         "-exportOptionsPlist \"#{write_export_options}\" " \
         "#{xcodebuild_auth_flags}")
    end

    {
      api_key: api_key,
      ipa: locate_ipa,
      build_name: build_name,
      build_number: build_number
    }
  end
end

# --- helpers ----------------------------------------------------------------

# Absolute path to the repository root (the parent of this fastlane/ folder).
def project_root
  @project_root ||= begin
    folder = FastlaneCore::FastlaneFolder.path
    root = folder ? File.expand_path("..", folder) : Dir.pwd
    unless File.exist?(File.join(root, "ios", "Runner.xcodeproj", "project.pbxproj"))
      UI.user_error!("No native Xcode project in #{root}.")
    end
    root
  end
end

# ASC_KEY_P8 may hold either the .p8 file's contents verbatim or its base64; both
# are easy to produce by hand, and telling them apart here is cheaper than getting
# it wrong. Passing a verbatim PEM to `app_store_connect_api_key` with
# is_key_content_base64 set makes Base64.decode64 fold the "-----BEGIN PRIVATE
# KEY-----" header into the body (those characters are all in the base64 alphabet),
# yielding binary that fails deep inside OpenSSL as "string contains null byte".
# Whatever comes in, a clean base64 PEM goes out. No key material is ever logged.
def app_store_api_key_base64
  Base64.strict_encode64(app_store_api_key_pem)
end

# Writes the .p8 to a private temporary directory for the duration of the block so
# xcodebuild can authenticate with -authenticationKeyPath, then removes it. The key
# never lands anywhere tracked; *.p8 is gitignored as a second line of defence.
def with_xcode_signing_credentials
  @signing_workdir = Dir.mktmpdir("asc-signing")
  @api_key_file = File.join(@signing_workdir, "AuthKey_#{required_env('ASC_KEY_ID')}.p8")
  File.write(@api_key_file, app_store_api_key_pem)
  File.chmod(0o600, @api_key_file)
  yield
ensure
  FileUtils.rm_rf(@signing_workdir) if @signing_workdir
  @signing_workdir = nil
  @api_key_file = nil
end

# Credentials for xcodebuild's automatic (cloud) signing. The key id and issuer id
# are passed as shell references so their values never appear in the logged command.
def xcodebuild_auth_flags
  "-allowProvisioningUpdates " \
    "-authenticationKeyPath \"#{api_key_file}\" " \
    '-authenticationKeyID "$ASC_KEY_ID" ' \
    '-authenticationKeyIssuerID "$ASC_ISSUER_ID"'
end

# Stable output used by the release workflow artifact upload.
def ipa_output_dir
  File.join(project_root, "build", "ios", "ipa")
end

def write_export_options
  path = File.join(signing_workdir, "ExportOptions.plist")
  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
    \t<key>destination</key>
    \t<string>export</string>
    \t<key>method</key>
    \t<string>app-store-connect</string>
    \t<key>signingStyle</key>
    \t<string>automatic</string>
    \t<key>teamID</key>
    \t<string>#{DEVELOPMENT_TEAM}</string>
    \t<key>uploadSymbols</key>
    \t<true/>
    </dict>
    </plist>
  PLIST
  path
end

def signing_workdir
  @signing_workdir || UI.user_error!("signing_workdir used outside with_xcode_signing_credentials")
end

def api_key_file
  @api_key_file || UI.user_error!("api_key_file used outside with_xcode_signing_credentials")
end

def app_store_api_key_pem
  return @app_store_api_key_pem if @app_store_api_key_pem

  raw = required_env("ASC_KEY_P8").strip
  pem = raw.start_with?("-----BEGIN") ? raw : Base64.decode64(raw)

  # A .p8 captured through PowerShell's default UTF-16 output decodes to text with
  # a NUL between every character. Recover it rather than failing on a text-encoding
  # quirk that has nothing to do with the key itself.
  if pem.include?("\x00")
    UI.important("ASC_KEY_P8 decoded to UTF-16 text; converting to UTF-8.")
    pem = begin
      pem.dup.force_encoding(Encoding::UTF_16LE).encode(Encoding::UTF_8)
    rescue EncodingError
      pem.delete("\x00")
    end
  end
  pem = pem.dup.force_encoding(Encoding::UTF_8).delete("\uFEFF").delete("\r").strip

  unless pem.start_with?("-----BEGIN") && pem.include?("PRIVATE KEY")
    UI.user_error!(
      "ASC_KEY_P8 is not a PEM private key (#{pem.bytesize} bytes after decoding). " \
      "Set it to either the .p8 file's contents verbatim, or its base64 built from " \
      "the raw file bytes -- on Windows, " \
      "[Convert]::ToBase64String([IO.File]::ReadAllBytes('AuthKey_XXXXXXXXXX.p8'))."
    )
  end

  UI.message("ASC_KEY_P8 -> #{pem.bytesize} bytes, #{pem.lines.first.strip}")
  @app_store_api_key_pem = pem
end

def required_env(name)
  value = ENV[name]
  UI.user_error!("Missing required environment variable #{name}.") if value.nil? || value.strip.empty?
  value
end

# Read the native target's MARKETING_VERSION. The build number is supplied by
# App Store Connect.
def marketing_version
  project = File.read(File.join(project_root, "ios", "Runner.xcodeproj", "project.pbxproj"))
  name = project[/MARKETING_VERSION = ([^;]+);/, 1]
  UI.user_error!("Could not read MARKETING_VERSION from the Xcode project.") if name.nil?
  name
end

def locate_ipa
  candidates = Dir.glob(File.join(project_root, "build", "ios", "ipa", "*.ipa"))
  UI.user_error!("No .ipa found in build/ios/ipa.") if candidates.empty?
  candidates.max_by { |path| File.mtime(path) }
end
